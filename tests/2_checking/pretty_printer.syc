require ha_non_existant
 
require ha
 
circuit fa
  input a : bit
  input b : bit
  input cin : bit
  output sum : bit 
  output cout : bit 
  wire s1 : bit 
  wire c1 : bit 
  wire c2 : bit 
  wire w1 : bit 
  wire w2 : bit 
  instance ha1 : ha
  instance ha2 : ha
  instance ha2 : ha
  instance ha3 : ha
  instance ha4 : ha_fantome
  ha42.a = a
  ha1.a = a
  ha1.b = b
  ha1.c = b
  ha1.sum = a
  s1 = ha1.sum
  c1 = ha1.carry
  w2 = ha1.a
  map ha2(s1,c1,sum,c2)
  map ha4(s1,c1,sum,c2)
  map ha3(s1,c1,sum,c2,w2)
  map ha2(1,0,sum,c2)
  map ha2(sum,0,a,0)
  cout = c1 or c2
end
 
