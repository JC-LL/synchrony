
circuit counter
  input e : bit
  output bit_5 : bit
  output field_6_2 : bits(5)
  #.........................
  output field_7_0 : bits(8)

  wire count               : uint(6) init 0
  wire bit8                : bits(8)
  wire field_15_0          : bits(16)
  wire field_15_0_signed   : int(16)
  wire field_15_0_unsigned : uint(16)
  wire field_3_2           : bits(2)
  wire int8                : int(8)

  # <| means DFF !
  count               <| e==1 ? (count + 1) : count

  bit_5               <~ count[5]
  field_6_2           <~ count[6:2]                           # ERROR : type error. 'count[6:2]' out of bounds. 'count' width is 6 bits (5..0).
  field_7_0           <~ count[3] ~ count[4:2] ~ count[1:0]   # ERROR : type error. Width mismatch in left/right hand side of assignment : 8 vs 7.
  field_15_0          <~ resize(field_7_0,15)                 # ERROR : type error. Width mismatch in left/right hand side of assignment : 16 vs 15.
  field_15_0_signed   <~ signed(field_15_0)
  field_15_0_unsigned <~ signed(field_15_0)                   # ERROR : type error. Type mismatch in left/right hand side of assignment : uint(16) vs int(16).
  field_7_0           <~ resize(field_15_0,8)                 # WARNING : truncation in 'resize(field_15_0,8)'. bits(16) to bits(8).
end
